{
  "name": "weread-assistant",
  "version": "0.1.1",
  "private": true,
  "description": "Unofficial auto-reading assistant for WeRead with a web management panel",
  "main": "src/cli.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lonemoonspace/Weread-Assistant.git"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "start": "node src/cli.js panel",
    "panel": "node src/cli.js panel",
    "check": "node scripts/check.js",
    "test:notify": "node scripts/notify-smoke.js",
    "test:reader": "node scripts/reader-smoke.js",
    "test:panel": "node scripts/panel-smoke.js",
    "test:config": "node scripts/config-smoke.js",
    "test:ui": "node scripts/ui-smoke.js",
    "test:runtime": "node scripts/runtime-smoke.js docker",
    "docker:image:help": "node scripts/docker-image.js help",
    "docker:image:check": "node scripts/docker-image.js check",
    "docker:image:build": "node scripts/docker-image.js build",
    "docker:image:push": "node scripts/docker-image.js push",
    "docker:image:push:dev": "node scripts/docker-image.js push --tag dev"
  },
  "dependencies": {
    "croner": "10.0.1",
    "express": "^5.3.0",
    "jsqr": "^1.4.0",
    "nodemailer": "^10.1.1",
