{
  "name": "weread-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial auto-reading assistant for WeRead with a web management panel",
  "main": "src/weread-challenge.js",
  "bin": {
    "weread-challenge": "src/weread-challenge.js",
    "weread-selenium-cli": "src/weread-challenge.js"
  },
  "files": [
    "src",
    "README.md",
    "README-dev.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lonemoonspace/Weread-Assistant.git"
  },
  "scripts": {
    "start": "WEREAD_SELECTION=-1 WEREAD_REMOTE_BROWSER=http://172.23.0.2:4444 node src/weread-challenge.js run",
    "dev": "WEREAD_REMOTE_BROWSER= node src/weread-challenge.js run",
    "debug": "DEBUG=true WEREAD_REMOTE_BROWSER= node src/weread-challenge.js run",
    "test:runtime": "node scripts/runtime-smoke.js all",
    "test:notify": "node scripts/notify-smoke.js",
    "test:runtime:npx": "node scripts/runtime-smoke.js npx",
    "test:runtime:docker": "node scripts/runtime-smoke.js docker",
    "link:global": "npm link",
    "unlink:global": "npm unlink -g weread-selenium-cli",
    "docker:image:help": "node scripts/docker-image.js help",
    "docker:image:check": "node scripts/docker-image.js check",
    "docker:image:build": "node scripts/docker-image.js build",
    "docker:image:push": "node scripts/docker-image.js push",
    "docker:image:push:dev": "node scripts/docker-image.js push --tag dev"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "nodemailer": "^6.9.16",
    "pngjs": "^7.0.0",
    "qrcode-terminal": "^0.12.0",
    "selenium-webdriver": "^4.27.0"
  }
}
